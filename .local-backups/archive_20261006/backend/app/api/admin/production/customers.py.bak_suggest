@router.get("/{customer_id}/opportunities")
def list_opportunities_api(
    customer_id: int,
    status: str | None = Query(default=None),
    include_inactive: bool = Query(default=False),
    db: Session = Depends(get_db),
    user: User = Depends(get_current_user),
    permission_codes: list[str] = Depends(get_current_permissions),
):
    _need_customer(db, user.tenant_id, customer_id, user, permission_codes)
    recycled = recycle_stale_opportunities(db, tenant_id=user.tenant_id, days=_recycle_days(db, user.tenant_id))
    if recycled:
        db.commit()
    items = list_opportunities(
        db,
        tenant_id=user.tenant_id,
        customer_id=customer_id,
        status=status,
        include_inactive=include_inactive,
        scope_stmt=_opportunity_scope(permission_codes, user),
    )
    return ok({"items": [_opp_out(x) for x in items]})


@router.post("/{customer_id}/opportunities")
def create_opportunity_api(
    customer_id: int,
    payload: CrmOpportunityCreateIn,
    db: Session = Depends(get_db),
    user: User = Depends(get_current_user),
    permission_codes: list[str] = Depends(get_current_permissions),
):
    _need_customer(db, user.tenant_id, customer_id, user, permission_codes)
    owner_user_id = payload.owner_user_id
    if owner_user_id is None:
        owner_user_id = user.id
    if owner_user_id is not None:
        u = db.get(User, owner_user_id)
        if not u or u.tenant_id != user.tenant_id:
            raise HTTPException(status_code=400, detail="负责人不存在")
    code = payload.code
    if not code:
        import uuid
        code = f"OPP{user.tenant_id:03d}{uuid.uuid4().hex[:8].upper()}"
    item = create_opportunity(
        db,
        tenant_id=user.tenant_id,
        customer_id=customer_id,
        code=code,
        title=payload.title,
        stage=payload.stage,
        status=payload.status,
        amount=payload.amount,
        probability=payload.probability,
        expected_close_date=payload.expected_close_date,
        owner_user_id=owner_user_id,
        remark=payload.remark,
        is_active=payload.is_active,
    )
    db.commit()
    return ok({"id": item.id, "code": item.code})


@router.put("/{customer_id}/opportunities/{opportunity_id}")
def update_opportunity_api(
    customer_id: int,
    opportunity_id: int,
    payload: CrmOpportunityUpdateIn,
    db: Session = Depends(get_db),
    user: User = Depends(get_current_user),
    permission_codes: list[str] = Depends(get_current_permissions),
):
    _need_customer(db, user.tenant_id, customer_id, user, permission_codes)
    item = get_opportunity_by_id(db, tenant_id=user.tenant_id, opportunity_id=opportunity_id, with_activities=False)
    if not item or item.customer_id != customer_id:
        raise HTTPException(status_code=400, detail="销售机会不存在")
    if not can_access_opportunity(db, user, item, permission_codes):
        raise HTTPException(status_code=403, detail="无权访问该销售机会")
    if payload.owner_user_id is not None:
        u = db.get(User, payload.owner_user_id)
        if not u or u.tenant_id != user.tenant_id:
            raise HTTPException(status_code=400, detail="负责人不存在")
    update_opportunity(
        db,
        item,
        title=payload.title,
        stage=payload.stage,
        status=payload.status,
        amount=payload.amount,
        probability=payload.probability,
        expected_close_date=payload.expected_close_date,
        owner_user_id=payload.owner_user_id,
        remark=payload.remark,
        is_active=payload.is_active,
    )
    db.commit()
    return ok({"id": item.id})


