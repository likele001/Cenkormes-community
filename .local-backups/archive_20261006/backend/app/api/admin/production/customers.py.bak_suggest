@router.post("/{customer_id}/opportunities/{opportunity_id}/convert-to-order")
def convert_opportunity_to_order_api(
    customer_id: int,
    opportunity_id: int,
    payload: OpportunityConvertToOrderIn,
    db: Session = Depends(get_db),
    user: User = Depends(get_current_user),
    permission_codes: list[str] = Depends(get_current_permissions),
):
    _need_customer(db, user.tenant_id, customer_id, user, permission_codes)
    opp = get_opportunity_by_id(db, tenant_id=user.tenant_id, opportunity_id=opportunity_id, with_activities=False)
    if not opp or opp.customer_id != customer_id:
        raise HTTPException(status_code=400, detail="销售机会不存在")
    if not can_access_opportunity(db, user, opp, permission_codes):
        raise HTTPException(status_code=403, detail="无权操作该销售机会")
    if opp.status != "open":
        raise HTTPException(status_code=400, detail="仅进行中的销售机会可转订单")
    if opp.converted_order_id:
        raise HTTPException(status_code=400, detail="该销售机会已转订单")
    if not payload.items:
        raise HTTPException(status_code=400, detail="请至少添加一行订单明细")

    from app.crud.sku import get_sku_by_id

    items_in: list[OrderItemCreateIn] = payload.items
    order_items: list[tuple[int, int, int, str | None]] = []
    for it in items_in:
        sku = get_sku_by_id(db, tenant_id=user.tenant_id, sku_id=it.sku_id)
        if not sku:
            raise HTTPException(status_code=400, detail=f"型号不存在: {it.sku_id}")
        order_items.append((it.line_no, it.sku_id, it.qty, it.remark))

    order_code = resolve_code(
        db,
        tenant_id=user.tenant_id,
        biz_type=BizType.ORDER,
        code=None,
        exists=lambda c: get_order_by_code(db, user.tenant_id, c) is not None,
        duplicate_msg="订单号已存在",
    )
    remark = payload.remark or opp.title
    order = create_order(
        db,
        tenant_id=user.tenant_id,
        customer_id=customer_id,
        code=order_code,
        due_date=payload.due_date or opp.expected_close_date,
        remark=remark,
        items=order_items,
        opportunity_id=opp.id,
    )
    update_opportunity(
        db,
        opp,
        stage="won",
        status="won",
        converted_order_id=order.id,
    )
    create_opportunity_activity(
        db,
        tenant_id=user.tenant_id,
        opportunity_id=opp.id,
        action_type="convert_order",
        content=f"已转订单 {order.code}",
        created_by=user.id,
    )
    notify_users_with_permission(
        db,
        tenant_id=user.tenant_id,
        permission_code="order.manage",
        title="商机已转订单",
        content=f"销售机会 {opp.code} 已转为订单 {order.code}，待审核",
        level="info",
        biz_type="order",
        biz_id=order.id,
    )
    if opp.owner_user_id and opp.owner_user_id != user.id:
        create_notification(
            db,
            tenant_id=user.tenant_id,
            user_id=opp.owner_user_id,
            title="商机已转订单",
            content=f"销售机会 {opp.code} 已转为订单 {order.code}",
            level="info",
            biz_type="crm_opportunity",
            biz_id=opp.id,
        )
    db.commit()
    return ok({"order_id": order.id, "order_code": order.code, "opportunity_id": opp.id})


@router.get("/{customer_id}/tags")
def list_customer_tags_api(
    customer_id: int,
    db: Session = Depends(get_db),
    user: User = Depends(get_current_user),
    permission_codes: list[str] = Depends(get_current_permissions),
):
    _need_customer(db, user.tenant_id, customer_id, user, permission_codes)
    links = list_customer_tag_links(db, tenant_id=user.tenant_id, customer_id=customer_id)
    return ok(
        {
            "items": [
                {
                    "tag_id": x.tag_id,
                    "tag_name": x.tag.name if x.tag else None,
                    "tag_color": x.tag.color if x.tag else None,
                }
                for x in links
                if x.tag and x.tag.is_active
            ]
        }
    )


@router.put("/{customer_id}/tags")
def set_customer_tags_api(
    customer_id: int,
    payload: CustomerTagsSetIn,
    db: Session = Depends(get_db),
    user: User = Depends(get_current_user),
    permission_codes: list[str] = Depends(get_current_permissions),
):
    _need_customer(db, user.tenant_id, customer_id, user, permission_codes)
    try:
        set_customer_tags(db, tenant_id=user.tenant_id, customer_id=customer_id, tag_ids=payload.tag_ids)
    except ValueError:
        raise HTTPException(status_code=400, detail="标签不存在")
    db.commit()
    return ok({"customer_id": customer_id, "tag_ids": payload.tag_ids})


# ============================================================
# 客户 360 画像
# ============================================================

@router.get("/{customer_id}/profile")
def get_customer_profile_api(
    customer_id: int,
    db: Session = Depends(get_db),
    user: User = Depends(get_current_user),
    permission_codes: list[str] = Depends(get_current_permissions),
):
    from app.crud.crm import recalculate_customer_profile  # noqa: F401
    cust = _need_customer(db, user.tenant_id, customer_id, user, permission_codes)
    profile_fn = getattr(__import__("app.crud.crm", fromlist=["get_customer_profile"]), "get_customer_profile", None)
    if callable(profile_fn):
        result = profile_fn(db, tenant_id=user.tenant_id, customer_id=customer_id)
        if result is not None:
            if isinstance(result, dict):
                return ok(result)
            data = {}
            for attr in dir(result):
                if attr.startswith("_"):
                    continue
                try:
                    data[attr] = getattr(result, attr)
                except Exception:
                    continue
            return ok(data)
    # 兜底：返回基本信息 + 聚合字段占位
    return ok({
        "customer_id": getattr(cust, "id", customer_id),
        "name": getattr(cust, "name", None),
        "code": getattr(cust, "code", None),
        "owner_user_id": getattr(cust, "owner_user_id", None),
        "total_opportunities": 0,
        "won_amount": 0.0,
        "total_quotations": 0,
        "total_contracts": 0,
        "total_activities": 0,
    })


@router.post("/{customer_id}/profile/recalculate")
def recalculate_customer_profile_api(
    customer_id: int,
    db: Session = Depends(get_db),
    user: User = Depends(get_current_user),
    permission_codes: list[str] = Depends(get_current_permissions),
):
    _need_customer(db, user.tenant_id, customer_id, user, permission_codes)
    mod = __import__("app.crud.crm", fromlist=["recalculate_customer_profile"])
    fn = getattr(mod, "recalculate_customer_profile", None)
    if not callable(fn):
        raise HTTPException(status_code=501, detail="底层实现尚未就绪")
    fn(db, tenant_id=user.tenant_id, customer_id=customer_id)
    db.commit()
    return ok({"customer_id": customer_id, "recalculated": True})


@router.post("/{customer_id}/leads/convert")
def convert_customer_leads_api(
    customer_id: int,
    payload: dict = None,
    db: Session = Depends(get_db),
    user: User = Depends(get_current_user),
    permission_codes: list[str] = Depends(get_current_permissions),
):
    """将某客户下的线索（或指定 lead_id）转为机会/客户。"""
    _need_customer(db, user.tenant_id, customer_id, user, permission_codes)
    import app.crud.crm as _crm
    fn = getattr(_crm, "convert_customer_leads", None)
    if not callable(fn):
        raise HTTPException(status_code=501, detail="底层实现尚未就绪")
    data = payload.dict(exclude_unset=True) if hasattr(payload, "dict") else (dict(payload) if payload else {})
    result = fn(db, tenant_id=user.tenant_id, customer_id=customer_id, user_id=user.id, **data)
    db.commit()
    if isinstance(result, dict):
        return ok(result)
    return ok({"customer_id": customer_id, "converted": True})
