router = APIRouter(dependencies=[Depends(require_any_permissions(["customer.manage", "crm.sales"]))])

RECYCLE_DAYS_KEY = "crm.public_pool.recycle_days"


def _recycle_days(db: Session, tenant_id: int) -> int:
    s = get_setting(db, tenant_id=tenant_id, key=RECYCLE_DAYS_KEY)
    if not s or not s.value:
        return 30
    try:
        return int(str(s.value).strip())
    except Exception:
        return 30


def _out(x, db: Session | None = None, tenant_id: int | None = None) -> dict:
    login_username = None
    owner_name = None
    if x.user_id and db is not None and tenant_id is not None:
        u = get_user_by_id(db, tenant_id=tenant_id, user_id=x.user_id)
        if u:
            login_username = u.username
    if getattr(x, "owner_user_id", None) and db is not None and tenant_id is not None:
        ou = get_user_by_id(db, tenant_id=tenant_id, user_id=x.owner_user_id)
        if ou:
            owner_name = ou.full_name or ou.username
    product_count = 0
    if db is not None and tenant_id is not None:
        product_count = len(list_customer_product_ids(db, tenant_id, x.id))
    return {
        "id": x.id,
        "tenant_id": x.tenant_id,
        "user_id": x.user_id,
        "owner_user_id": getattr(x, "owner_user_id", None),
        "owner_name": owner_name,
        "login_username": login_username,
        "product_count": product_count,
        "code": x.code,
        "name": x.name,
        "contact_name": x.contact_name,
        "contact_phone": x.contact_phone,
        "address": x.address,
        "remark": x.remark,
        "is_active": x.is_active,
        "created_at": x.created_at,
        "updated_at": x.updated_at,
    }


def _opp_out(x) -> dict:
    return {
        "id": x.id,
        "tenant_id": x.tenant_id,
        "customer_id": x.customer_id,
        "code": x.code,
        "title": x.title,
        "stage": x.stage,
        "status": x.status,
        "amount": float(x.amount) if x.amount is not None else None,
        "probability": x.probability,
        "expected_close_date": str(x.expected_close_date) if x.expected_close_date else None,
        "owner_user_id": x.owner_user_id,
        "owner_name": x.owner.full_name if x.owner else None,
        "converted_order_id": getattr(x, "converted_order_id", None),
        "converted_order_code": x.converted_order.code if getattr(x, "converted_order", None) else None,
        "remark": x.remark,
        "is_active": x.is_active,
        "created_at": x.created_at,
        "updated_at": x.updated_at,
    }


def _customer_scope(permission_codes: list[str], user: User):
    return lambda stmt: apply_customer_scope(stmt, user, permission_codes)


def _opportunity_scope(permission_codes: list[str], user: User):
    return lambda stmt: apply_opportunity_scope(stmt, user, permission_codes)


def _need_customer(db: Session, tenant_id: int, customer_id: int, user: User, permission_codes: list[str]):
    c = get_customer_by_id(db, tenant_id=tenant_id, customer_id=customer_id)
    if not c:
        raise HTTPException(status_code=400, detail="客户不存在")
    if not can_access_customer(db, user, c, permission_codes):
        raise HTTPException(status_code=403, detail="无权访问该客户")
    return c


@router.get("")
def list_api(
    keyword: str | None = Query(default=None),
    owner_user_id: int | None = Query(default=None, ge=1),
    offset: int = Query(default=0, ge=0),
    limit: int = Query(default=50, ge=1, le=200),
    include_inactive: bool = Query(default=False),
    db: Session = Depends(get_db),
    user: User = Depends(get_current_user),
    permission_codes: list[str] = Depends(get_current_permissions),
):
    items = list_customers(
        db,
        tenant_id=user.tenant_id,
        keyword=keyword,
        owner_user_id=owner_user_id,
        offset=offset,
        limit=limit,
        include_inactive=include_inactive,
        scope_stmt=_customer_scope(permission_codes, user),
    )
    return ok({"items": [_out(x, db, user.tenant_id) for x in items]})


@router.get("/{customer_id}")
def get_api(
    customer_id: int,
    db: Session = Depends(get_db),
    user: User = Depends(get_current_user),
    permission_codes: list[str] = Depends(get_current_permissions),
):
    item = _need_customer(db, user.tenant_id, customer_id, user, permission_codes)
    return ok(_out(item, db, user.tenant_id))


@router.get("/{customer_id}/products")
def list_customer_products_api(
    customer_id: int,
    db: Session = Depends(get_db),
    user: User = Depends(get_current_user),
    permission_codes: list[str] = Depends(get_current_permissions),
):
    c = _need_customer(db, user.tenant_id, customer_id, user, permission_codes)
    products = list_customer_products_with_detail(db, tenant_id=user.tenant_id, customer_id=c.id)
    return ok(
        {
            "product_ids": [p.id for p in products],
            "items": [{"id": p.id, "code": p.code, "name": p.name, "category": p.category} for p in products],
        }
    )


@router.put("/{customer_id}/products")
def set_customer_products_api(
    customer_id: int,
    payload: CustomerProductsSetIn,
    db: Session = Depends(get_db),
    user: User = Depends(get_current_user),
    permission_codes: list[str] = Depends(get_current_permissions),
):
    c = _need_customer(db, user.tenant_id, customer_id, user, permission_codes)
    ids = set_customer_products(db, tenant_id=user.tenant_id, customer_id=c.id, product_ids=payload.product_ids)
    db.commit()
    return ok({"customer_id": c.id, "product_ids": ids})


@router.post("")
def create_api(
    payload: CustomerCreateIn,
    db: Session = Depends(get_db),
    user: User = Depends(get_current_user),
    permission_codes: list[str] = Depends(get_current_permissions),
):
    customer_code = resolve_code(
        db,
        tenant_id=user.tenant_id,
        biz_type=BizType.CUSTOMER,
        code=payload.code,
        exists=lambda c: get_customer_by_code(db, user.tenant_id, c) is not None,
        duplicate_msg="客户编码已存在",
    )
    owner_user_id = payload.owner_user_id
    if owner_user_id is None and not crm_has_full_access(user, permission_codes):
        owner_user_id = user.id
    if owner_user_id is not None:
        ou = get_user_by_id(db, tenant_id=user.tenant_id, user_id=owner_user_id)
        if not ou:
            raise HTTPException(status_code=400, detail="负责人不存在")
    item = create_customer(
        db,
        tenant_id=user.tenant_id,
        code=customer_code,
        name=payload.name,
        user_id=None,
        contact_name=payload.contact_name,
        contact_phone=payload.contact_phone,
        address=payload.address,
        remark=payload.remark,
        is_active=payload.is_active,
        owner_user_id=owner_user_id,
    )
    ensure_customer_login_user(
        db,
        user.tenant_id,
        item,
        user_id=payload.user_id,
        login_username=payload.login_username,
        login_password=payload.login_password,
    )
    db.commit()
    return ok(_out(item, db, user.tenant_id))


@router.put("/{customer_id}")
def update_api(
    customer_id: int,
    payload: CustomerUpdateIn,
    db: Session = Depends(get_db),
    user: User = Depends(get_current_user),
    permission_codes: list[str] = Depends(get_current_permissions),
):
    item = _need_customer(db, user.tenant_id, customer_id, user, permission_codes)
    if payload.code is not None and payload.code != item.code:
        exists = get_customer_by_code(db, tenant_id=user.tenant_id, code=payload.code)
        if exists:
            raise HTTPException(status_code=400, detail="客户编码已存在")
    update_customer(
        db,
        item=item,
        code=payload.code,
        name=payload.name,
        user_id=item.user_id,
        contact_name=payload.contact_name,
        contact_phone=payload.contact_phone,
        address=payload.address,
        remark=payload.remark,
        is_active=payload.is_active,
        owner_user_id=payload.owner_user_id,
    )
    if payload.user_id is not None or payload.login_username or payload.login_password:
        ensure_customer_login_user(
            db,
            user.tenant_id,
            item,
            user_id=payload.user_id,
            login_username=payload.login_username,
            login_password=payload.login_password,
        )
    db.commit()
    return ok(_out(item, db, user.tenant_id))


