  { path: '/finance/profit', i18nKey: 'menu.financeProfit', permissions: ['finance.manage'], icon: TrendCharts },
  { path: '/finance/payables', i18nKey: 'menu.financePayables', permissions: ['finance.manage'], icon: Money },
]

const erpAll: MenuItem[] = [
  { path: '/erp/invoices', i18nKey: 'menu.erpInvoices', permissions: ['erp.manage'], icon: Document },
  { path: '/erp/accounts', i18nKey: 'menu.erpAccounts', permissions: ['erp.manage'], icon: Coin },
  { path: '/erp/vouchers', i18nKey: 'menu.erpVouchers', permissions: ['erp.manage'], icon: List },
  { path: '/erp/trial-balance', i18nKey: 'menu.erpTrialBalance', permissions: ['erp.manage'], icon: DataAnalysis },
  { path: '/erp/balance-sheet', i18nKey: 'menu.erpBalanceSheet', permissions: ['erp.manage'], icon: TrendCharts },
  { path: '/erp/costs', i18nKey: 'menu.erpCosts', permissions: ['erp.manage'], icon: Money },
  { path: '/erp/assets', i18nKey: 'menu.erpAssets', permissions: ['erp.manage'], icon: Box },
  { path: '/erp/assets/depreciation', i18nKey: 'menu.erpAssetDepreciation', permissions: ['erp.manage'], icon: Timer },
  { path: '/erp/assets/checks', i18nKey: 'menu.erpAssetChecks', permissions: ['erp.manage'], icon: Search },
]

const intelAll: MenuItem[] = [
  { path: '/ai/agent-chat', i18nKey: 'menu.aiAgentChat', permissions: ['ai.use'], icon: ChatDotRound },
  { path: '/ai/assistant', i18nKey: 'menu.aiAssistant', permissions: ['ai.use'], icon: MagicStick },
  { path: '/ai/recommendations', i18nKey: 'menu.aiRecommendations', permissions: ['ai.use'], icon: Bell },
  { path: '/ai/alerts', i18nKey: 'menu.aiAlerts', permissions: ['ai.alert.view'], icon: WarningFilled },
  { path: '/ai/employees', i18nKey: 'menu.aiEmployees', permissions: ['ai_employee.manage'], icon: MagicStick },
  { path: '/ai/equipment-health', i18nKey: 'menu.aiEquipmentHealth', permissions: ['ai.use'], icon: Monitor },
  { path: '/ai/yield-prediction', i18nKey: 'menu.aiYieldPrediction', permissions: ['ai.use'], icon: DataAnalysis },
  { path: '/ai/twin', i18nKey: 'menu.aiTwin', permissions: ['ai.use'], icon: TrendCharts },
  { path: '/ai/causal', i18nKey: 'menu.aiCausal', permissions: ['ai.use'], icon: Share },
  { path: '/ai/quality-patterns', i18nKey: 'menu.aiQualityPatterns', permissions: ['ai.use'], icon: Histogram },
  { path: '/ai/pricing', i18nKey: 'menu.aiPricing', permissions: ['ai.use'], icon: Money },
  { path: '/ai/rag-index', i18nKey: 'menu.aiRagIndex', permissions: ['ai.use'], icon: Document },
  { path: '/system/help', i18nKey: 'menu.intelHelp', permissions: ['ai.use'], icon: QuestionFilled },
  { path: '/system/ai-deep', i18nKey: 'menu.aiDeep', permissions: ['ai.use'], icon: TrendCharts },
  { path: '/system/ai-stats', i18nKey: 'menu.aiStats', permissions: ['ai.use'], icon: DataLine },
  { path: '/system/automation-settings', i18nKey: 'menu.automationSettings', permissions: ['setting.manage'], icon: SetUp },
]

const systemItems = computed(() => systemAll.filter((x) => auth.hasAnyPermission(x.permissions)))
const intelItems = computed(() => intelAll.filter((x) => auth.hasAnyPermission(x.permissions)))
const showIntelSubMenu = computed(
  () => auth.hasAnyPermission(['ai.use']) || intelItems.value.length > 0,
)
const masterItems = computed(() => masterAll.filter((x) => auth.hasAnyPermission(x.permissions)))
const crmItems = computed(() => crmAll.filter((x) => auth.hasAnyPermission(x.permissions)))
const productionItems = computed(() => productionAll.filter((x) => auth.hasAnyPermission(x.permissions)))
const purchaseItems = computed(() => purchaseAll.filter((x) => auth.hasAnyPermission(x.permissions)))
const financeItems = computed(() => financeAll.filter((x) => auth.hasAnyPermission(x.permissions)))
const erpItems = computed(() => erpAll.filter((x) => auth.hasAnyPermission(x.permissions)))

const dataItems = computed(() => {
  const rows: (MenuItem & { permissions: string[] })[] = [
    { path: '/reports', i18nKey: 'menu.reportsOverview', permissions: ['report.view'], icon: DataAnalysis },
    { path: '/reports/purchase', i18nKey: 'menu.reportsPurchase', permissions: ['report.view'], icon: Histogram },
  ]
  return rows.filter((x) => auth.hasAnyPermission(x.permissions))
})
</script>
