<script setup lang="ts">
import type { Component } from 'vue'
import { computed } from 'vue'
import { useRoute, useRouter } from 'vue-router'
import { useAuthStore } from '@/stores/auth'
import {
  House,
  DataBoard,
  DataLine,
  Setting,
  Box,
  Operation,
  ShoppingCart,
  Wallet,
  Histogram,
  Monitor,
  User,
  Key,
  Lock,
  OfficeBuilding,
  Tools,
  Document,
  Bell,
  Calendar,
  Star,
  CollectionTag,
  FolderOpened,
  Notebook,
  Goods,
  Grid,
  Van,
  Connection,
  Share,
  Money,
  UserFilled,
  Position,
  PieChart,
  DocumentCopy,
  List,
  DocumentChecked,
  EditPen,
  TrendCharts,
  Coin,
  Search,
  DataAnalysis,
  QuestionFilled,
  MagicStick,
  ChatDotRound,
  SetUp,
  Timer,
  Clock,
  Message,
  Aim,
  WarningFilled,
  Upload,
  Files,
  InfoFilled,
} from '@element-plus/icons-vue'
import { useI18n } from 'vue-i18n'

const { t } = useI18n()

const props = withDefaults(
